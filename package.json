{
  "name": "lirio-semijoias",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo + carrinho da Lírio Semijoias (HTML/CSS/JS puro + Firebase).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regras": "firebase emulators:exec --only database \"vitest run --config vitest.rules.config.js\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.47.0",
    "http-server": "^14.1.1",
    "vitest": "^2.1.1"
  }
}
